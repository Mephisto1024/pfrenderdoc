layout(location = 2) in vec4 in_COLOR0;
layout(location = 3) in vec4 in_TEXCOORD0;
layout(location = 0) out vec4 out_Target0;
void main(){
  float f0;
  (f0 = pc0_h[0].x);
  vec4 v1;
  vec4 v2;
  (v2.xyzw = in_COLOR0);
  vec4 v3;
  (v3.xyz = v2.xyz);
  (v3.w = v2.w);
  vec4 v4;
  vec4 v5;
